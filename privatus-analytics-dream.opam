# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "1.0.0"
synopsis: "Privatus Analytics tracking script for Dream web apps"
description:
  "A Dream middleware that can add the cookieless Privatus Analytics script to the head of HTML pages, and helpers for Dream .eml templates: the script tag, custom event attributes, click map names and page props from the request. It never sends events from your server and sets no cookies."
maintainer: ["Two Phase LLC <james@privatusanalytics.com>"]
authors: ["Two Phase LLC <james@privatusanalytics.com>"]
license: "MIT"
tags: ["analytics" "privacy" "web" "dream"]
homepage: "https://privatusanalytics.com"
doc: "https://privatusanalytics.com/docs"
bug-reports: "https://github.com/Privatus-Analytics/ocaml/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "4.14"}
  "privatus-analytics" {= version}
  "dream" {>= "1.0.0~alpha5"}
  "lwt" {>= "5.3.0"}
  "alcotest" {with-test & >= "1.5"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/Privatus-Analytics/ocaml.git"
