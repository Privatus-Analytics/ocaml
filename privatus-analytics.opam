# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "1.0.0"
synopsis: "Cookieless Privatus Analytics tracking script for OCaml web apps"
description:
  "Prints the Privatus Analytics browser script tag, page props and the data attributes for custom events and click maps. It only builds HTML. It never sends events from your server and sets no cookies. The optional privatus-analytics.tyxml library adds TyXML attribute helpers."
maintainer: ["Two Phase LLC <james@privatusanalytics.com>"]
authors: ["Two Phase LLC <james@privatusanalytics.com>"]
license: "MIT"
tags: ["analytics" "privacy" "web" "html"]
homepage: "https://privatusanalytics.com"
doc: "https://privatusanalytics.com/docs"
bug-reports: "https://github.com/Privatus-Analytics/ocaml/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "4.14"}
  "alcotest" {with-test & >= "1.5"}
  "odoc" {with-doc}
]
depopts: ["tyxml"]
conflicts: [
  "tyxml" {< "4.5"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/Privatus-Analytics/ocaml.git"
